# Copy this file to .env and fill in values
# Never commit .env

# ── Neon PostgreSQL ──
# Pooled connection (for app runtime — goes through PgBouncer)
STRM_TRKR_DATABASE_URL="postgresql://..."
# Direct connection (for migrations — bypasses PgBouncer)
STRM_TRKR_DATABASE_URL_UNPOOLED="postgresql://..."

# ── Better Auth ──
STRM_TRKR_BETTER_AUTH_SECRET=""
# Stable production URL. On Vercel Preview, omit this — auth.ts falls back to VERCEL_URL.
STRM_TRKR_BETTER_AUTH_URL="https://storm-tracker-murex.vercel.app"

# ── Vercel Blob Storage (file attachments) ──
BLOB_READ_WRITE_TOKEN=""

# ── AI (journal import) ──
ANTHROPIC_API_KEY=""

# ── Legacy Neon integration vars (set automatically by Vercel, not used by app code) ──
# STRM_TRKR_NEON_PROJECT_ID, STRM_TRKR_PGUSER, STRM_TRKR_PGPASSWORD,
# STRM_TRKR_POSTGRES_DATABASE, STRM_TRKR_POSTGRES_USER, STRM_TRKR_POSTGRES_PASSWORD,
# STRM_TRKR_PGDATABASE — these exist in Vercel but are NOT used by the app.
# Do not remove them (managed by the Neon integration).
